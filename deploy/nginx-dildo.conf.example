# Place in your nginx sites configuration AFTER configuring TLS and htpasswd.
# Assumes this hostname is dedicated to this application.
server {
    listen 443 ssl;
    server_name dildo.asia;
    ssl_certificate /etc/letsencrypt/live/dildo.asia/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dildo.asia/privkey.pem;
    client_max_body_size 16m;

    # Machine API: FT_API_TOKEN must be set on FT-Node. The prefix is stripped.
    location /api/ {
        auth_basic off;
        proxy_pass http://127.0.0.1:8094/;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-FT-Authenticated "";
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 120s;
    }

    # Browser UI and its same-origin API requests use HTTP Basic authentication.
    location / {
        auth_basic "FineTune workspace";
        auth_basic_user_file /etc/nginx/ft-node.htpasswd;
        proxy_pass http://127.0.0.1:8094;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Forwarded-Host $host;
        # Overwrite caller-provided headers; trust only this loopback proxy.
        proxy_set_header X-FT-Authenticated "1";
        proxy_set_header Authorization "";
        proxy_read_timeout 120s;
    }
}
server {
    listen 80;
    server_name dildo.asia;
    return 301 https://$host$request_uri;
}
