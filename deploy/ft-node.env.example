# Install as /etc/ft-node/ft-node.env (root:ft-node, 0640).
# Mandatory for the public API. Generate a long random token locally.
FT_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
FT_VAST_KEY=/etc/ft-node/vast_api_key
FT_SSH_KEY=/etc/ft-node/id_ed25519
# Remote model must be a HF checkpoint ID or an existing path on the GPU image.
FT_REMOTE_MODEL=Qwen/Qwen3.5-0.8B-Base
# Local model path used by the CPU worker:
RTB_FINETUNE_MODEL=/opt/ft-node/models/base
