{
  "vast_api": "https://console.vast.ai/api/v0",
  "vast_key_file": "/etc/ft-node/vast_api_key",
  "gpu": {
    "min_vram_gb": 16,
    "max_dph": 0.8,
    "disk_gb": 50,
    "gpu_names": ["RTX 3090", "RTX 4090", "RTX A5000", "A4000", "L4"],
    "reliability": 0.95
  },
  "instance": {
    "image": "ghcr.io/martinroot/bigpu-coldstart/z-image:latest",
    "template_hash": null,
    "label_prefix": "zimg-cs-",
